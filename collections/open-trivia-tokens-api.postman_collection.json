          "request": {
            "name": "Open Trivia Manage Session Token",
            "description": {
              "content": "Request a new session token or reset an existing one. Session tokens prevent duplicate questions across calls and expire after six hours of inactivity. Use `command=request` to obtain a new token and `command=reset` with the token parameter to recycle an existing token's served-question set.",
              "type": "text/plain"
            },
            "url": {
