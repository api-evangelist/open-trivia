    {
      "id": "25ad727d-6947-48b5-b489-3ecaeee248d8",
      "name": "Questions",
      "description": {
        "content": "Operations for retrieving trivia questions from the database.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3d9ab94f-8fa3-47bc-8774-7c28d84ed0cb",
          "name": "Open Trivia Get Trivia Questions",
          "request": {
            "name": "Open Trivia Get Trivia Questions",
            "description": {
              "content": "Retrieve a batch of trivia questions from the Open Trivia Database. Questions can be filtered by category, difficulty, and type. A session token may be supplied to prevent the same question from being returned twice within a six-hour window.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "10",
                  "description": "(Required) Number of questions to return. Must be between 1 and 50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<integer>",
                  "description": "Numeric category identifier. Use /api_category.php to discover valid category IDs (range 9-32). Omit to draw from any category."
                },
                {
                  "disabled": false,
                  "key": "difficulty",
                  "value": "<string>",
                  "description": "Restrict questions to a single difficulty level."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Restrict questions to a single answer format. `multiple` returns four-option multiple-choice questions; `boolean` returns true/false questions."
                },
                {
                  "disabled": false,
                  "key": "encode",
                  "value": "<string>",
                  "description": "Response encoding for textual fields. Defaults to HTML-entity encoded plain text. `urlLegacy` applies legacy URL encoding, `url3986` applies RFC 3986 percent encoding, and `base64` applies Base64 encoding."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Session token returned by /api_token.php. When provided, the API tracks which questions have been served and avoids returning duplicates until the token is reset or expires."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
