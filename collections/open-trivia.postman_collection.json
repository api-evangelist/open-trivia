          "id": "25723d3f-dee9-4d60-be01-d889c36b17ee",
          "name": "Open Trivia Manage Session Token",
          "request": {
            "name": "Open Trivia Manage Session Token",
            "description": {
              "content": "Request a new session token or reset an existing one. Session tokens prevent duplicate questions across calls and expire after six hours of inactivity. Use `command=request` to obtain a new token and `command=reset` with the token parameter to recycle an existing token's served-question set.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api_token.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "command",
                  "value": "<string>",
                  "description": "(Required) The token operation to perform."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Existing session token. Required when `command=reset`; ignored when `command=request`."
                }
              ],
              "variable": []
            },
            "header": [
