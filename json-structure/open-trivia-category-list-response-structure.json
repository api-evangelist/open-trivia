{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/open-trivia/refs/heads/main/json-structure/open-trivia-category-list-response-structure.json",
  "name": "CategoryListResponse",
  "description": "Response returned by /api_category.php.",
  "type": "object",
  "properties": {
    "trivia_categories": {
      "type": "array",
      "description": "All trivia categories currently available in the database.",
      "items": {"$ref": "#/definitions/Category"}
    }
  },
  "required": ["trivia_categories"],
  "definitions": {
    "Category": {
      "type": "object",
      "properties": {
        "id": {"type": "int32", "minimum": 9, "maximum": 32},
        "name": {"type": "string"}
      },
      "required": ["id", "name"]
    }
  }
}
